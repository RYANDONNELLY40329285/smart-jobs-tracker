generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Job {
  id           Int        @id @default(autoincrement())
  title        String
  company      String
  location     String?
  link         String?
  status       JobStatus  @default(APPLIED)
  roleType     String?
  dateApplied  DateTime   @default(now())
  createdAt    DateTime   @default(now())

  notes        Note[]
  interviews   Interview[]
}

model Note {
  id      Int    @id @default(autoincrement())
  content String
  jobId   Int

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)
}

model Interview {
  id      Int      @id @default(autoincrement())
  stage   String
  date    DateTime
  outcome String?
  jobId   Int

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)
}

enum JobStatus {
  APPLIED
  SCREENING
  INTERVIEW
  OFFER
  REJECTED
}